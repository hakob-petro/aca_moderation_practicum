#!/usr/bin/env bash
# Seminar 2 checks.   Usage:  ./check 1   (or 2, 3, 4)
set -uo pipefail

# Your own ports and your own Docker, as set at login on the class server.
MYPORT="${MYPORT:-$(( 10000 + ($(id -u) - 1000) * 10 ))}"
if [ -z "${DOCKER_HOST:-}" ] && [ -S "/run/user/$(id -u)/docker.sock" ]; then
  export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
fi

pass=0; fail=0
ok()   { printf 'PASS  %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf 'FAIL  %s\n' "$1"; fail=$((fail + 1)); [ -n "${2:-}" ] && printf '      -> %s\n' "$2"; }
lower() { tr '[:upper:]' '[:lower:]'; }

get() {
  [ -f "$1" ] || return 0
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n 1 | tr -d '\r' | sed 's/[[:space:]]*$//'
}

running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]; }

need_docker() {
  if docker info >/dev/null 2>&1; then return 0; fi
  bad "your Docker is not answering" "systemctl --user start docker, wait a few seconds, then run the check again"
  return 1
}

check1() {
  local f="$HOME/s2/m1.txt" v want
  need_docker || return

  if [ -n "$(docker ps -aq --filter ancestor=hello-world)" ]; then ok "hello-world ran"
  else bad "hello-world has not run yet" "docker run hello-world"; fi

  if ! docker inspect web >/dev/null 2>&1; then ok "the web container is stopped and removed"
  elif running web; then bad "web is still running" "docker stop web, then docker rm web"
  else bad "web is stopped but not removed" "docker rm web"; fi

  if [ ! -f "$f" ]; then
    bad "answers file ~/s2/m1.txt" "mkdir -p ~/s2 && cp ~/course/seminar_2/templates/m1.txt ~/s2/m1.txt && nano ~/s2/m1.txt"
    return
  fi

  v=$(get "$f" container_os | lower)
  if [ "$v" = "alpine" ]; then ok "container_os: $v"
  else bad "container_os: ${v:-empty}" "inside the container, cat /etc/os-release: the ID line"; fi

  v=$(get "$f" nginx_version | tr -dc '0-9.')
  want=$(docker run --rm --entrypoint nginx nginx:1.27-alpine -v 2>&1 | sed -n 's#.*nginx/\([0-9][0-9.]*\).*#\1#p' | head -n 1)
  if [ -n "$v" ] && [ "$v" = "$want" ]; then ok "nginx_version: $v"
  else bad "nginx_version: ${v:-empty}" "inside the container: nginx -v"; fi
}

check2() {
  local src port page
  need_docker || return

  if ! docker inspect site >/dev/null 2>&1; then
    bad "no container called site" "follow step 3 of mission 2"
    return
  fi
  if running site; then ok "site is running"
  else bad "site is not running" "docker logs site shows why; then docker start site"; fi

  port=$(docker port site 80 2>/dev/null | head -n 1)
  if [ "$port" = "127.0.0.1:$MYPORT" ]; then ok "site is published on 127.0.0.1:$MYPORT, your port"
  else bad "site is published on ${port:-nothing}" "it should be -p 127.0.0.1:$MYPORT:80"; fi

  src=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/usr/share/nginx/html"}}{{.Source}}{{end}}{{end}}' site)
  if [ "$src" = "$HOME/s2/site" ]; then ok "your folder ~/s2/site is mounted into the container"
  else bad "~/s2/site is not mounted into the container" "-v ~/s2/site:/usr/share/nginx/html:ro"; fi

  page=$(curl -fsS -m 5 "http://127.0.0.1:$MYPORT/" 2>/dev/null)
  if printf '%s' "$page" | grep -q "$USER"; then ok "the page shows your username"
  else bad "the page does not show your username, $USER" "edit ~/s2/site/index.html, then reload the page"; fi
}

# Runs a short SQL query in Open WebUI's own database, inside its container.
owui_sql() {
  docker exec "$1" python3 -c "
import sqlite3, sys
db = sqlite3.connect('/app/backend/data/webui.db')
try:
    print(db.execute(sys.argv[1]).fetchone()[0])
except Exception:
    print('')
" "$2" 2>/dev/null
}

# Checks shared by missions 3 and 4: what is inside Open WebUI.
owui_inside() {
  local cid="$1" port="$2" users chats router
  if curl -fsS -m 5 "http://127.0.0.1:$port/health" >/dev/null 2>&1; then ok "Open WebUI answers on 127.0.0.1:$port"
  else bad "Open WebUI does not answer yet" "it takes up to a minute to start; docker logs shows its progress"; return; fi

  users=$(owui_sql "$cid" "select count(*) from user")
  if [ "${users:-0}" -ge 1 ]; then ok "an account exists ($users)"
  else bad "no account yet" "open it through your tunnel and create your account first"; fi

  router=$(docker exec "$cid" python3 -c "
import sqlite3
db = sqlite3.connect('/app/backend/data/webui.db')
rows = db.execute('select * from config').fetchall()
print('yes' if any('openrouter.ai' in str(r) for r in rows) else '')
" 2>/dev/null)
  [ -z "$router" ] && docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | grep -q 'openrouter.ai' && router=yes
  if [ "$router" = "yes" ]; then ok "connected to OpenRouter"
  else bad "not connected to OpenRouter yet" "Admin Panel, Settings, Connections: URL https://openrouter.ai/api/v1 and your key"; fi

  chats=$(owui_sql "$cid" "select count(*) from chat")
  if [ "${chats:-0}" -ge 1 ]; then ok "you have $chats chat(s)"
  else bad "no chat yet" "New Chat, pick your free model, ask something"; fi
}

owui_volume_ok() {
  local vol
  vol=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/app/backend/data"}}{{.Type}} {{.Name}}{{end}}{{end}}' "$1")
  if [ "$vol" = "volume openwebui-data" ]; then ok "its data is in the volume openwebui-data"
  else bad "its data is not in the volume openwebui-data" "-v openwebui-data:/app/backend/data"; fi
}

check3() {
  local port=$((MYPORT + 1)) cid pub
  need_docker || return

  cid=$(docker ps -q --filter "publish=$port" | head -n 1)
  if [ -z "$cid" ]; then bad "nothing is running on your port $port" "start Open WebUI with the docker run command in step 2"; return; fi
  if docker inspect -f '{{.Config.Image}}' "$cid" | grep -q 'open-webui'; then ok "Open WebUI is running"
  else bad "something else runs on your port $port" "docker ps shows what; remove it and start Open WebUI"; return; fi

  pub=$(docker port "$cid" 8080 2>/dev/null | head -n 1)
  if [ "$pub" = "127.0.0.1:$port" ]; then ok "published on 127.0.0.1:$port, your port"
  else bad "published on ${pub:-nothing}" "-p 127.0.0.1:$port:8080"; fi

  owui_volume_ok "$cid"
  owui_inside "$cid" "$port"
}

check4() {
  local dir="$HOME/s2/openwebui" port=$((MYPORT + 1)) cid policy pub
  need_docker || return

  if [ ! -f "$dir/compose.yml" ]; then
    bad "no ~/s2/openwebui/compose.yml" "follow step 1 of mission 4"
    return
  fi
  if grep -q '"TODO"\|: TODO\|- TODO' "$dir/compose.yml"; then bad "compose.yml still has a TODO" "fill in all three"; return; fi
  ok "compose.yml is filled in"
  if grep -q 'sk-or-' "$dir/compose.yml"; then bad "your OpenRouter key is written in compose.yml" "remove it: Open WebUI keeps it in its database, in the volume"
  else ok "no key in compose.yml"; fi

  if docker inspect openwebui >/dev/null 2>&1; then bad "the container from mission 3 still exists" "docker rm -f openwebui (the volume stays)"
  else ok "the mission 3 container is gone"; fi

  cid=$(cd "$dir" && docker compose ps -q openwebui 2>/dev/null | head -n 1)
  if [ -z "$cid" ]; then bad "Open WebUI is not running from Compose" "cd ~/s2/openwebui && docker compose up -d"; return; fi
  ok "Open WebUI runs from Compose"

  policy=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$cid")
  case "$policy" in
    always|unless-stopped|on-failure) ok "restart policy: $policy" ;;
    *) bad "restart policy: ${policy:-none}" "restart: unless-stopped" ;;
  esac

  pub=$(docker port "$cid" 8080 2>/dev/null | head -n 1)
  if [ "$pub" = "127.0.0.1:$port" ]; then ok "published on 127.0.0.1:$port, your port"
  else bad "published on ${pub:-nothing}" "\"127.0.0.1:\${PORT}:8080\", with PORT=$port in .env"; fi

  owui_volume_ok "$cid"
  owui_inside "$cid" "$port"
}

# Homework: the app broken three ways.
check_broken() {
  local port=$((MYPORT + 3)) page pub
  need_docker || return

  if docker image inspect broken-app >/dev/null 2>&1; then ok "the image broken-app is built"
  else bad "no image called broken-app yet" "cd ~/s2/broken && docker build -t broken-app .   Then read the error"; return; fi

  if ! docker inspect fixed >/dev/null 2>&1; then
    bad "no container called fixed" "run it with the command from the homework card"
    return
  fi
  if running fixed; then ok "fixed is running"
  else bad "fixed started and then stopped" "docker logs fixed tells you why"; return; fi

  pub=$(docker port fixed 2>/dev/null | head -n 1)
  page=$(curl -fsS -m 5 "http://127.0.0.1:$port/" 2>/dev/null)
  if printf '%s' "$page" | grep -q "Hello from"; then ok "it answers: $page"
  else bad "nothing answers on 127.0.0.1:$port" "docker port fixed shows what you published ($pub); docker logs fixed shows which port the app listens on"; fi

  if printf '%s' "$pub" | grep -q "127.0.0.1:$port"; then ok "published on 127.0.0.1:$port, your port"
  else bad "published on ${pub:-nothing}" "use -p 127.0.0.1:$port:..."; fi
}

case "${1:-}" in
  1) check1 ;;
  2) check2 ;;
  3) check3 ;;
  4) check4 ;;
  broken) check_broken ;;
  *) echo "Usage: ./check N   (N = 1, 2, 3 or 4; or: ./check broken, for the homework)"; exit 2 ;;
esac

echo
if [ "$fail" -eq 0 ]; then echo "MISSION $1: ALL $pass PASSED. Colour your cell on the board."
else echo "MISSION $1: $fail to fix. Follow the arrows above, then run ./check $1 again."; exit 1; fi
